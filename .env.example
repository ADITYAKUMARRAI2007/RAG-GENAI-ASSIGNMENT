# ─────────────────────────────────────────────
# DocuMind RAG — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# OpenRouter API Key (required)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenAI API Key (used for embeddings only)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── Qdrant Configuration ───────────────────
# LOCAL (Docker): http://localhost:6333
# CLOUD: https://your-cluster-url.qdrant.io
QDRANT_URL=http://localhost:6333

# Qdrant Cloud API Key (only needed for Qdrant Cloud)
QDRANT_API_KEY=

# Collection name in Qdrant
QDRANT_COLLECTION_NAME=assignment_03_notebooklm_rag
